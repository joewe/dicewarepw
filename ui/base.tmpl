{{define "base"}}
<!doctype html>
<html lang='de'>
    <head>
        <meta charset='utf-8'>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Diceware Passphrase Generator - {{template "title" .}}</title>
        <meta name="description" content="Kryptografisch sichere, merkbare Passphrasen nach dem Diceware-Verfahren generieren.">
        <meta name="keywords" content="diceware, passphrase, generator, security, random, password, passwort">
        <meta name="author" content="Joerg.fyi">
        <meta name="theme-color" content="#0b0f19">

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

        <!-- CSS Stylesheet and Favicon -->
        <link rel='stylesheet' href='/static/css/style.css'>
        <link rel='shortcut icon' href='/static/img/dice.ico' type='image/x-icon'>
        <script src='/static/js/main.js' type='text/javascript' defer></script>
    </head>
    <body>
        <div class="glow-orb orb-primary"></div>
        <div class="glow-orb orb-secondary"></div>

        <div class="app-layout">
            <header class="app-header">
                <a href='/' class="logo-link">
                    <div class="logo-icon-badge">🎲</div>
                    <div class="logo-text">
                        <span class="logo-title">Diceware</span>
                        <span class="logo-tag">Generator</span>
                    </div>
                </a>
                <p class="tagline">Kryptografisch sichere &amp; merkbare Passphrasen</p>
            </header>

            {{template "nav" .}}

            <main class="main-card">
                {{template "main" .}}
            </main>

            <footer class="app-footer">
                <p>&copy; 2025-2026 <a href='https://joerg.fyi/' target='_blank' rel='noopener noreferrer'>Joerg.fyi</a> &bull; In-Memory generiert &bull; Keine Speicherung</p>
            </footer>
        </div>
    </body>
</html>
{{end}}